PORT=5000
DATA_BACKEND=supabase
SUPABASE_DB_URL=postgresql://postgres.xxx:xxx@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
SUPABASE_POOL_MAX=10
SUPABASE_TTL_SWEEP=true

JWT_SECRET=your_jwt_secret

RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

RAZORPAY_X_KEY_ID=your_razorpayx_key_id
RAZORPAY_X_KEY_SECRET=your_razorpayx_key_secret
RAZORPAY_X_ACCOUNT_NUMBER=your_razorpayx_account_number

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password
EMAIL_FROM_NAME=Pravixo

FRONTEND_URL=https://pravixo.com
ADMIN_URL=https://pravixo-web-admin.vercel.app

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_EMAIL=mailto:support@pravixo.com

META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_CLIENT_ID=your_meta_client_id
META_CLIENT_SECRET=your_meta_client_secret
META_REDIRECT_URI=https://www.pravixo.com/oauth/callback
